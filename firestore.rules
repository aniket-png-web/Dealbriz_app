rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'redevilaed@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connectivity test document
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection: PII isolation, owner or admin only
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && incoming().uid == request.auth.uid;
      allow update: if isValidId(userId) && isOwner(userId) && incoming().uid == existing().uid;
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // User notifications subcollection
      match /notifications/{notificationId} {
        allow get, list: if isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isAdmin()) && incoming().userId == userId;
        allow update: if isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isAdmin()) && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isAdmin());
      }
    }
  }
}
